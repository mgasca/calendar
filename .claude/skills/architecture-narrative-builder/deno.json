{
  "compilerOptions": { "strict": true, "noUncheckedIndexedAccess": true },
  "lock": { "path": "deno.lock", "frozen": true },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "fmt": { "include": ["**/*.ts", "deno.json"], "exclude": ["**/fixtures/**"], "lineWidth": 120 },
  "lint": { "include": ["**/*.ts"], "exclude": ["**/fixtures/**"] },
  "test": { "include": ["**/*_test.ts"], "exclude": ["**/fixtures/**"] },
  "tasks": {
    "stitch": "deno run --frozen --no-prompt --allow-read --allow-write scripts/stitch/stitch.ts",
    "test": "deno test --permit-no-files --no-prompt --allow-read --allow-write"
  }
}
