{
  "compilerOptions": { "strict": true, "noUncheckedIndexedAccess": true },
  "lock": { "path": "deno.lock", "frozen": true },
  "imports": {
    "pg": "npm:pg@8.16.3",
    "@types/pg": "npm:@types/pg@8.15.5",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/yaml": "jsr:@std/yaml@1.3.0"
  },
  "fmt": { "include": ["**/*.ts", "deno.json"], "exclude": ["**/fixtures/**"], "lineWidth": 120 },
  "lint": { "include": ["**/*.ts"], "exclude": ["**/fixtures/**"] },
  "test": { "include": ["**/*_test.ts"], "exclude": ["**/fixtures/**", "**/integration/**"] },
  "tasks": {
    "delivery-guards": "deno run --frozen --no-prompt --allow-read delivery-guards/delivery-guards.ts",
    "test": "deno test --permit-no-files --no-prompt --allow-read --allow-write --allow-run --allow-env"
  }
}
