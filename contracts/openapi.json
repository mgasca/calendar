{
  "openapi": "3.1.1",
  "info": {
    "title": "Calendar.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "operationId": "CreateEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "operationId": "GetEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "operationId": "CreateTask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "operationId": "GetTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/complete": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "operationId": "CompleteTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/reopen": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "operationId": "ReopenTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/agenda/day": {
      "get": {
        "tags": [
          "Agenda"
        ],
        "summary": "Everything for one local day: all-day events, timed events, and due-today and overdue tasks.",
        "operationId": "GetDayAgenda",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "timeZone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayAgendaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgendaTasks": {
        "required": [
          "overdue",
          "dueToday"
        ],
        "type": "object",
        "properties": {
          "overdue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            },
            "description": "Overdue tasks, oldest due first: still open, or completed within the day. Not due on the day itself."
          },
          "dueToday": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            },
            "description": "Tasks due on the day (open or completed): timed ones by due instant, then date-only ones by title."
          }
        }
      },
      "AgendaWindow": {
        "required": [
          "start",
          "end"
        ],
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "The day as UTC instants: [start, end)."
      },
      "AllDayEventItem": {
        "required": [
          "id",
          "title",
          "startDate",
          "endDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          }
        },
        "description": "An all-day event in the day agenda (floating dates, end exclusive)."
      },
      "CreateEventRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Required, at most 200 characters after trimming."
          },
          "allDay": {
            "type": "boolean",
            "description": "True for an all-day event (startDate/endDate), false for a timed one (start/end/timeZone)."
          },
          "start": {
            "type": [
              "null",
              "string"
            ],
            "description": "Timed events: inclusive start instant, RFC 3339 with an explicit offset (e.g. 2026-10-26T14:00:00Z).",
            "format": "date-time"
          },
          "end": {
            "type": [
              "null",
              "string"
            ],
            "description": "Timed events: exclusive end instant, after start.",
            "format": "date-time"
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ],
            "description": "Timed events: IANA time zone the event was created in, e.g. America/New_York."
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "All-day events: first date (YYYY-MM-DD).",
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "All-day events: exclusive end date (YYYY-MM-DD), after startDate; a one-day event on the 26th ends on the 27th.",
            "format": "date"
          },
          "location": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional, at most 200 characters."
          },
          "notes": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional, at most 4000 characters."
          }
        },
        "description": "Create an event. Discriminated by bool CreateEventRequest.AllDay: a timed event needs `start`, `end` and\n`timeZone`; an all-day event needs `startDate` and `endDate` (end exclusive) and no timed fields."
      },
      "CreateTaskRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Required, at most 200 characters after trimming."
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Floating due date (YYYY-MM-DD); mutually exclusive with dueAt.",
            "format": "date"
          },
          "dueAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Due instant, RFC 3339 with an explicit offset; mutually exclusive with dueDate.",
            "format": "date-time"
          }
        },
        "description": "Create a task, optionally due on a floating date or at an instant (not both)."
      },
      "DayAgendaResponse": {
        "required": [
          "date",
          "timeZone",
          "window",
          "allDayEvents",
          "events",
          "tasks"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string",
            "description": "Canonical IANA time zone id the day was resolved in."
          },
          "window": {
            "$ref": "#/components/schemas/AgendaWindow"
          },
          "allDayEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllDayEventItem"
            },
            "description": "All-day events covering the date, by start date then title."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimedEventItem"
            },
            "description": "Timed events overlapping the window, by start then title."
          },
          "tasks": {
            "$ref": "#/components/schemas/AgendaTasks"
          }
        },
        "description": "Everything for one local day, from a single snapshot."
      },
      "EventResponse": {
        "required": [
          "id",
          "title",
          "allDay"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "allDay": {
            "type": "boolean"
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "start": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "end": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ]
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        },
        "description": "An event as stored. Fields of the other kind are `null`."
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TaskResponse": {
        "required": [
          "id",
          "title",
          "isCompleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "dueAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the task was completed; null while it is open.",
            "format": "date-time"
          },
          "isCompleted": {
            "type": "boolean"
          }
        }
      },
      "TimedEventItem": {
        "required": [
          "id",
          "title",
          "start",
          "end",
          "timeZone",
          "startsBeforeDay",
          "endsAfterDay"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "startsBeforeDay": {
            "type": "boolean",
            "description": "The event began before the day's window (it continues from an earlier day)."
          },
          "endsAfterDay": {
            "type": "boolean",
            "description": "The event ends after the day's window (it continues into a later day)."
          }
        },
        "description": "A timed event in the day agenda."
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Events"
    },
    {
      "name": "Tasks"
    },
    {
      "name": "Agenda"
    }
  ]
}