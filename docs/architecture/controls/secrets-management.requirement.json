{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgasca.github.io/calendar/architecture/controls/secrets-management.requirement.json",
  "title": "Secrets management requirement",
  "description": "Where secrets live, who can read them and how they reach the workload (ADR-0032, ADR-0034).",
  "type": "object",
  "properties": {
    "store": { "type": "string" },
    "vaults": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "purpose": { "type": "string" }, "readers": { "type": "array", "items": { "type": "string" } } }, "required": ["name", "purpose"] } },
    "access-model": { "type": "string", "description": "RBAC or access policies." },
    "workload-identity": { "type": "string" },
    "delivery": { "type": "string", "description": "How secrets reach the running container." },
    "allowed-secret-names": { "type": "array", "items": { "type": "string" } },
    "secrets-in-repository": { "type": "boolean" },
    "audit-logging": { "type": "string" },
    "adrs": { "type": "array", "items": { "type": "string", "format": "uri" } }
  },
  "required": ["store", "access-model", "delivery", "secrets-in-repository"],
  "additionalProperties": false
}
