{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" warm",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(just *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(docker *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(env *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(sudo *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(exec *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(builtin *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(command *)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-bash",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/openapi.json)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-edit",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(**/schema.gen.ts)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-edit",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(**/packages.lock.json)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-edit",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(**/pnpm-lock.yaml)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-edit",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(**/deno.lock)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" pre-edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/tools/**/*.ts)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" post-edit",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(**/.claude/skills/**/*.ts)",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" post-edit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --config \"$CLAUDE_PROJECT_DIR/tools/deno.json\" --frozen --no-prompt --allow-read --allow-run --allow-env \"$CLAUDE_PROJECT_DIR/tools/agent-hooks/agent-hooks.ts\" stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
