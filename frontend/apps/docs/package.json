{
  "name": "@calendar/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "bench": "vitest run --config vitest.bench.config.ts",
    "verify:build": "vitest run tests",
    "validate:architecture": "calm validate --architecture ../../../docs/architecture/calendar.architecture.json --url-to-local-file-mapping ../../../docs/architecture/url-mapping.json --strict"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.8",
    "@calendar/theme": "workspace:*",
    "astro": "^7.4.4",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@finos/calm-cli": "^1.67.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^31.0.0",
    "astro-mermaid": "^2.2.0",
    "mermaid": "^12.3.0",
    "tinybench": "^6.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
