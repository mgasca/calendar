# Copy to .env (untracked; `just db-up` does this for you). Values are disposable, local-only passwords:
# the database listens on 127.0.0.1 only. Never reuse them anywhere else.
POSTGRES_DB=calendar
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=dev-admin-password
CALENDAR_MIGRATOR_PASSWORD=dev-migrator-password
CALENDAR_APP_PASSWORD=dev-app-password

# Configure a Google OAuth web client in user-secrets or environment variables (never commit credentials).
# Register http://localhost:5173/api/auth/callback/google for the Vite proxy and
# http://localhost:5041/api/auth/callback/google for direct API access; production uses
# https://<host>/api/auth/callback/google. Set Auth__Google__ClientId, Auth__Google__ClientSecret,
# and indexed allow-list values such as Auth__AllowedEmails__0 in the API process environment.

# Development-only seed credential; replace with: openssl rand -hex 32
Auth__DevSeedKey=local-development-seed-key-change-me-123456
